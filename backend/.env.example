# Postgres connection string. Railway injects this automatically when you add a
# Postgres service; locally, point it at your own instance.
DATABASE_URL=postgresql://user:password@localhost:5432/dripos

# Base URL of the Dripos mock API that the catalog is seeded from.
MOCK_API_URL=https://crema.dripos.com/api/mock/YOUR_KEY

PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Run pending migrations on boot. Safe to leave on: it is advisory-locked and
# forward-only, so concurrent deploys cannot race.
RUN_MIGRATIONS_ON_START=true

# Fetch the catalog on every boot. Off by default; seed explicitly instead.
SEED_ON_START=false

# Bearer token guarding POST /admin/seed. REQUIRED in production — without it
# the endpoint is disabled rather than left open.
ADMIN_TOKEN=

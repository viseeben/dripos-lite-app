# Base URL of the Dripos Lite backend. This is the ONLY configuration the app
# needs. Copy this file to .env.local and set the value.
#
# Deployed:  https://your-service.up.railway.app
# Local:     http://192.168.1.50:3000
#
# Note: when running the backend locally, use your machine's LAN IP, not
# localhost. "localhost" on your phone means the phone itself.
EXPO_PUBLIC_API_URL=https://your-service.up.railway.app
